{
  "name": "@prestige-ui/typescript-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Prestige UI TypeScript port — zero-runtime-dependency desktop shell for Enterprise AI/ML Dashboards and Web3 Applications",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/finalize-umd.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke-umd.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.2",
    "happy-dom": "^20.11.1",
    "terser": "^5.31.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
